<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-lg-8 offset-lg-2">

        <!-- Listing Header -->
        <div class="show-header">
            <h2><%= listing.title %></h2>

            <p class="text-muted">
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <!-- Listing Image -->
        <img
            src="<%= listing.image?.url %>"
            class="show-main-image"
            alt="<%= listing.title %>"
        >

        <!-- Listing Details -->
        <div class="show-details">

            <!-- Owner -->
            <div class="owner-info">

                <div class="owner-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <strong>
                        Hosted by
                        <%= listing.owner?.username || "Unknown" %>
                    </strong>

                    <br>

                    <small class="text-muted">
                        Welcome to WanderLust
                    </small>
                </div>

            </div>

            <hr>

            <!-- Description -->
            <p class="show-description">
                <%= listing.description %>
            </p>

            <!-- Price -->
            <div class="show-price">
                ₹<%= listing.price.toLocaleString("en-IN") %>
                <span>night</span>
            </div>

            <!-- Location -->
            <div class="location-info">

                <i class="fa-solid fa-location-dot"></i>

                <span>
                    <%= listing.location %>,
                    <%= listing.country %>
                </span>

            </div>

            <!-- Category -->
            <div class="category-badge">

                <i class="fa-solid fa-tag"></i>

                <%= listing.category || "Trending" %>

            </div>

        </div>


        <!-- Edit / Delete Buttons -->
        <% if (
            currUser &&
            listing.owner &&
            listing.owner._id.equals(currUser._id)
        ) { %>

            <div class="btns mb-4">

                <a
                    href="/listings/<%= listing._id %>/edit"
                    class="btn btn-dark"
                >
                    <i class="fa-solid fa-pen"></i>
                    Edit
                </a>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>?_method=DELETE"
                    onsubmit="return confirm('Are you sure you want to delete this listing?');"
                >

                    <button
                        type="submit"
                        class="btn btn-outline-danger"
                    >
                        <i class="fa-solid fa-trash"></i>
                        Delete
                    </button>

                </form>

            </div>

        <% } %>


        <!-- Map -->
        <div class="map-section">

            <h3>Where you'll be</h3>

            <p class="text-muted">

                <i class="fa-solid fa-location-dot"></i>

                <%= listing.location %>,
                <%= listing.country %>

            </p>


            <% if (
                listing.geometry &&
                listing.geometry.coordinates &&
                listing.geometry.coordinates.length === 2
            ) { %>

                <div
                    id="map"
                    data-longitude="<%= listing.geometry.coordinates[0] %>"
                    data-latitude="<%= listing.geometry.coordinates[1] %>"
                ></div>

            <% } else { %>

                <div class="map-unavailable">

                    <i class="fa-solid fa-map-location-dot"></i>

                    <p>
                        Map location is not available for this listing.
                    </p>

                </div>

            <% } %>

        </div>


        <hr class="my-5">


        <!-- Reviews -->
        <div class="reviews-section">

            <h3>Reviews</h3>


            <!-- Add Review -->
            <% if (currUser) { %>

                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation review-form"
                >

                    <!-- Rating -->
                    <div class="mb-3">

                        <label class="form-label">
                            Rating
                        </label>

                        <fieldset class="starability-slot">

                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="1"
                                aria-label="No rating."
                            />

                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                                required
                            />

                            <label
                                for="first-rate1"
                                title="Terrible"
                            >
                                1 star
                            </label>


                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            />

                            <label
                                for="first-rate2"
                                title="Not good"
                            >
                                2 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            />

                            <label
                                for="first-rate3"
                                title="Average"
                            >
                                3 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            />

                            <label
                                for="first-rate4"
                                title="Very good"
                            >
                                4 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            />

                            <label
                                for="first-rate5"
                                title="Amazing"
                            >
                                5 stars
                            </label>

                        </fieldset>

                    </div>


                    <!-- Comment -->
                    <div class="mb-3">

                        <label
                            for="comment"
                            class="form-label"
                        >
                            Comment
                        </label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="4"
                            class="form-control"
                            placeholder="Share your experience..."
                            required
                        ></textarea>

                        <div class="invalid-feedback">
                            Please write a review.
                        </div>

                    </div>


                    <button
                        type="submit"
                        class="btn btn-dark"
                    >
                        Submit Review
                    </button>

                </form>

            <% } else { %>

                <!-- Login Message -->
                <div class="login-review-box">

                    <p>
                        Please log in to leave a review.
                    </p>

                    <a
                        href="/login"
                        class="btn btn-outline-dark"
                    >
                        Log in
                    </a>

                </div>

            <% } %>


            <!-- Review List -->
            <div class="row mt-4">

                <% if (listing.reviews.length === 0) { %>

                    <div class="col-12">

                        <p class="text-muted">
                            No reviews yet. Be the first to review this place!
                        </p>

                    </div>

                <% } %>


                <% listing.reviews.forEach(review => { %>

                    <div class="col-md-6 mb-3">

                        <div class="review-card">

                            <!-- Review Author -->
                            <div class="review-author">

                                <div class="review-avatar">

                                    <i class="fa-solid fa-user"></i>

                                </div>

                                <strong>
                                    @<%= review.author?.username || "Anonymous" %>
                                </strong>

                            </div>


                            <!-- Rating -->
                            <p
                                class="starability-result"
                                data-rating="<%= review.rating %>"
                            ></p>


                            <!-- Comment -->
                            <p class="review-comment">
                                <%= review.comment %>
                            </p>


                            <!-- Delete Review -->
                            <% if (
                                currUser &&
                                review.author &&
                                review.author._id.equals(currUser._id)
                            ) { %>

                                <form
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    onsubmit="return confirm('Delete this review?');"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                    >
                                        Delete
                                    </button>

                                </form>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </div>
</div>


<!-- Mapbox Token -->
<script>
    window.wanderlustMapToken = "<%= mapToken || '' %>";
</script>

<script src="/js/map.js"></script>