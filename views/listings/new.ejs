<% layout("/layouts/boilerplate") %>

<div class="row mt-4">

    <div class="col-lg-8 offset-lg-2">

        <div class="form-card">

            <h2>
                Create a New Listing
            </h2>

            <p class="text-muted">
                Add your stay to WanderLust.
            </p>

            <form
                method="POST"
                action="/listings"
                enctype="multipart/form-data"
                novalidate
                class="needs-validation"
            >

                <div class="mb-3">

                    <label class="form-label">
                        Title
                    </label>

                    <input
                        name="listing[title]"
                        placeholder="Add a catchy title"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a title.
                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea
                        name="listing[description]"
                        class="form-control"
                        rows="5"
                        placeholder="Describe your place"
                        required
                    ></textarea>

                    <div class="invalid-feedback">
                        Please add a description.
                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Listing Image
                    </label>

                    <input
                        name="listing[image]"
                        type="file"
                        accept="image/png,image/jpeg,image/webp"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please upload an image.
                    </div>

                </div>


                <div class="row">

                    <div class="mb-3 col-md-4">

                        <label class="form-label">
                            Price / Night
                        </label>

                        <input
                            name="listing[price]"
                            type="number"
                            min="0"
                            placeholder="1200"
                            class="form-control"
                            required
                        >

                    </div>


                    <div class="mb-3 col-md-8">

                        <label class="form-label">
                            Country
                        </label>

                        <input
                            name="listing[country]"
                            placeholder="India"
                            type="text"
                            class="form-control"
                            required
                        >

                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Location
                    </label>

                    <input
                        name="listing[location]"
                        placeholder="Jaipur, Rajasthan"
                        type="text"
                        class="form-control"
                        required
                    >

                    <small class="text-muted">
                        This location will be used to show the Mapbox map.
                    </small>

                </div>


                <div class="mb-4">

                    <label class="form-label">
                        Category
                    </label>

                    <select
                        name="listing[category]"
                        class="form-select"
                        required
                    >

                        <option value="">
                            Select category
                        </option>

                        <% categories.forEach(category => { %>

                            <option value="<%= category %>">
                                <%= category %>
                            </option>

                        <% }) %>

                    </select>

                </div>


                <button
                    type="submit"
                    class="btn btn-dark add-btn"
                >
                    <i class="fa-solid fa-plus"></i>
                    Add Listing
                </button>

            </form>

        </div>

    </div>

</div>