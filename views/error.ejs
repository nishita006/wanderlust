<% layout("/layouts/boilerplate") %>

<div class="row mt-5">

    <div class="col-lg-8 offset-lg-2">

        <div class="alert alert-danger text-center">

            <i class="fa-solid fa-triangle-exclamation fs-2 mb-3"></i>

            <h3>
                Something went wrong
            </h3>

            <p>
                <%= message %>
            </p>

            <a
                href="/listings"
                class="btn btn-dark"
            >
                Back to Explore
            </a>

        </div>

    </div>

</div>